[Unit]
Description=FEFU Lab Gunicorn
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/fefu_lab/Django1/web_2025
Environment="DJANGO_ENV=production"
Environment="PATH=/var/www/fefu_lab/Django1/venv/bin"
Environment="DJANGO_SECRET_KEY=a1b2c3d4e5f67890abcdef1234567890g1h2i3j4k5l6m7n8o9p0q1r2s3t4"
Environment="DB_NAME=fefu_lab_db"
Environment="DB_USER=fefu_user"
Environment="DB_PASSWORD=user"
Environment="DB_HOST=127.0.0.1"
Environment="DB_PORT=5432"

ExecStart=/var/www/fefu_lab/Django1/deploy/gunicorn \
    --config /var/www/fefu_lab/deploy/gunicorn/config.py \
    web_2025.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s TERM $MAINPID
Restart=always
PrivateTmp=true

[Install]
WantedBy=multi-user.target